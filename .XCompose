# regex: N0, N0, (.), (?:N?)(.), N0, N0, (.), (?:N?)(.)\s*# (.), (.)
# replace: <Multi_key> <u> <0> <0> <\L$1\E> <\L$2\E> <Return> : "$5"\n<Multi_key> <u> <0> <0> <\L$3\E> <\L$4\E> <Return> : "$6"

